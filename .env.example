# Checkout Radar Configuration

# TinyFish API credentials (auto-detected or mock mode fallback)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Set MOCK_TINYFISH=true to replay recorded deterministic runs without using credits/API calls
# Real mode is default (false)
MOCK_TINYFISH=false

# LLM Endpoint for Downstream CCPA Statutory Explanation (Optional; falls back to offline templates if empty)
# Free Tier Option 1 (Recommended - Groq, zero cost, no card):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_key_here
# LLM_MODEL=llama-3.3-70b-versatile
#
# Free Tier Option 2 (Google AI Studio, free 15 RPM):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIzaSy_your_gemini_key_here
# LLM_MODEL=gemini-1.5-flash
#
# Default OpenAI configuration:
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Execution limits & paths
MAX_RUNS_PER_AUDIT=12
AUDIT_INTERVAL=3600
SQLITE_DB_PATH=/app/data/checkout_radar.db
EVIDENCE_DIR=/app/data/evidence
FRONTEND_DIR=/app/frontend
