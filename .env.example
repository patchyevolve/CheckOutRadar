# Checkout Radar Configuration

# TinyFish API credentials (auto-detected or mock mode fallback)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Set MOCK_TINYFISH=true to replay recorded deterministic runs without using credits/API calls
# Real mode is default (false)
MOCK_TINYFISH=false

# Optional LLM API Endpoint for secondary candidate explanation
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Execution limits & paths
MAX_RUNS_PER_AUDIT=12
AUDIT_INTERVAL=3600
SQLITE_DB_PATH=/app/data/checkout_radar.db
EVIDENCE_DIR=/app/data/evidence
FRONTEND_DIR=/app/frontend
